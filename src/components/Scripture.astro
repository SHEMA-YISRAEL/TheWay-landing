---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { scripture } = t;
---

<section class="scripture" id="scripture">
  <div class="container">
    <div class="quote-mark" aria-hidden="true">"</div>
    <blockquote>
      <p>{scripture.quote[0]}<br />{scripture.quote[1]}</p>
      <footer>
        <cite>{scripture.ref}</cite>
      </footer>
    </blockquote>
    <div class="divider"></div>
    <p class="tagline">{scripture.tagline}</p>
  </div>
</section>

<style>
  .scripture {
    background: var(--fill-2);
    border-top: 1px solid var(--stroke-2);
    border-bottom: 1px solid var(--stroke-2);
    padding: 96px 0;
    text-align: center;
    overflow: hidden;
  }
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    position: relative;
    z-index: 1;
  }
  .quote-mark {
    font-family: var(--font-serif);
    font-size: 8rem;
    line-height: 0.6;
    color: var(--gold);
    opacity: 0.25;
    user-select: none;
    pointer-events: none;
    margin-bottom: -16px;
  }
  blockquote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  blockquote p {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--text-dark);
  }
  blockquote footer {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  blockquote footer::before,
  blockquote footer::after {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }
  cite {
    font-style: normal;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .divider {
    width: 48px;
    height: 2px;
    background: var(--stroke-2);
    border-radius: 100px;
  }
  .tagline {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 520px;
    opacity: 0.85;
  }
</style>
