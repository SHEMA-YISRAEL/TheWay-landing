---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { hero } = t;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grain"></div>
    <div class="hero-glow-1"></div>
    <div class="hero-glow-2"></div>
  </div>

  <div class="container">
    <div class="content">
      <div class="badge reveal">
        <span class="badge-dot"></span>
        {hero.badge}
      </div>

      <h1 class="reveal">
        {hero.h1[0]}<br />
        <em>{hero.h1[1]}</em>
      </h1>

      <p class="subtitle reveal">{hero.subtitle}</p>

      <form class="waitlist reveal" id="waitlist-form" novalidate>
        <div class="waitlist-input-wrap">
          <svg class="waitlist-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <input
            type="email"
            name="email"
            placeholder={hero.waitlist.placeholder}
            autocomplete="email"
            required
          />
        </div>
        <button type="submit" class="btn-cta">
          {hero.waitlist.cta}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
        <p class="waitlist-success" id="waitlist-success" aria-live="polite">{hero.waitlist.success}</p>
      </form>

      <p class="social-proof reveal">
        <em>{hero.socialProof}</em>
      </p>
    </div>

    <div class="phone-wrap reveal-fade">
      <div class="phone-glow"></div>
      <div class="phone">
        <div class="phone-notch" aria-hidden="true"></div>
        <div class="phone-inner">
          <img
            class="phone-screenshot"
            src="/demo.jpeg"
            alt="Captura de pantalla de BibleShep"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <div class="phone-reflection" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    if (!input?.value) return;

    const email = input.value.trim();

    try {
      await fetch('https://hook.us2.make.com/rijd9ek0zxu86mus18qo5bysagocitp7', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, date: new Date().toISOString() }),
      });
    } catch (_) {
      // silencioso — igual mostramos éxito para no bloquear al usuario
    }

    form.classList.add('submitted');
    input.value = '';
  });
</script>

<style>
  .hero {
    background: var(--fill-1);
    border-bottom: 1px solid var(--stroke-1);
    padding: 88px 0 108px;
    overflow: hidden;
    position: relative;
  }

  /* Background atmosphere */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  .hero-glow-1 {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(178,132,54,0.08) 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }

  .hero-glow-2 {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(178,132,54,0.05) 0%, transparent 70%);
    bottom: -50px;
    left: 10%;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
    position: relative;
    z-index: 1;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--fill-2);
    border: 1px solid var(--stroke-2);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 6px 14px;
    border-radius: 100px;
    width: fit-content;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-muted);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px var(--gold-muted); }
    50%       { box-shadow: 0 0 0 6px transparent; }
  }

  /* Heading */
  h1 {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-dark);
  }

  h1 em {
    font-style: italic;
    color: var(--gold);
    position: relative;
  }

  .subtitle {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
    max-width: 480px;
  }

  /* Waitlist form */
  .waitlist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 440px;
  }

  .waitlist-input-wrap {
    display: flex;
    align-items: center;
    gap: 0;
    background: #fff;
    border: 1.5px solid var(--stroke-1);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .waitlist-input-wrap:focus-within {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-muted);
  }

  .waitlist-icon {
    flex-shrink: 0;
    margin-left: 14px;
    color: var(--text);
    opacity: 0.35;
  }

  .waitlist-input-wrap input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    padding: 13px 14px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-dark);
  }

  .waitlist-input-wrap input::placeholder {
    color: var(--text);
    opacity: 0.45;
  }

  .btn-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--dark);
    color: #fdfcfb;
    border: none;
    cursor: pointer;
    padding: 13px 24px;
    border-radius: 14px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: background 0.2s ease, transform 0.15s var(--ease-out), box-shadow 0.2s ease;
  }

  .btn-cta:hover {
    background: var(--dark-2);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(30,26,21,0.18);
  }

  .btn-cta:active { transform: translateY(0); }

  .waitlist-success {
    font-size: 0.82rem;
    color: var(--gold);
    font-weight: 500;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .waitlist.submitted .waitlist-success {
    opacity: 1;
    transform: translateY(0);
  }

  .waitlist.submitted .waitlist-input-wrap,
  .waitlist.submitted .btn-cta {
    opacity: 0.4;
    pointer-events: none;
  }

  /* Social proof */
  .social-proof {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    color: var(--text);
    opacity: 0.7;
  }

  .social-proof em { font-style: italic; font-family: var(--font-serif); }

  /* Phone */
  .phone-wrap {
    display: flex;
    justify-content: center;
    position: relative;
    animation-delay: 0.3s !important;
  }

  .phone-glow {
    position: absolute;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, var(--gold-glow) 0%, transparent 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .phone {
    width: 272px;
    height: 556px;
    background: #1a1612;
    border-radius: 46px;
    padding: 10px;
    box-shadow:
      0 60px 120px rgba(0,0,0,0.22),
      0 0 0 1px rgba(0,0,0,0.14),
      inset 0 0 0 1px rgba(255,255,255,0.06);
    position: relative;
  }

  .phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 76px;
    height: 6px;
    background: #2a2520;
    border-radius: 100px;
    z-index: 1;
  }

  .phone-inner {
    background: #0b0a09;
    border-radius: 38px;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .phone-screenshot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #0b0a09;
  }

  /* Reflejo sutil */
  .phone-reflection {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 80px;
    background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, transparent 100%);
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 48px;
    }
    .content { align-items: center; }
    .subtitle { max-width: 520px; }
    .waitlist { max-width: 100%; align-items: stretch; }
    .social-proof { justify-content: center; }
    .phone-wrap { order: -1; }
    .phone { width: 240px; height: 490px; }
  }
</style>
