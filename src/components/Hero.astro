---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { hero } = t;
---

<section class="hero">
  <div class="container">
    <div class="content">
      <div class="badge">
        <span class="badge-dot"></span>
        {hero.badge}
      </div>

      <h1>{hero.h1[0]}<br /><em>{hero.h1[1]}</em></h1>

      <p class="subtitle">{hero.subtitle}</p>

      <div class="actions">
        <a href="#download" class="btn-store">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="btn-store-text">
            <span class="label">{hero.appStore.label}</span>
            <span class="platform">{hero.appStore.platform}</span>
          </div>
        </a>

        <a href="#download" class="btn-store">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.18 23.76c.3.17.64.24.99.21l12.6-12.6-2.61-2.61L3.18 23.76zM20.46 10.7l-2.7-1.56-2.94 2.94 2.94 2.94 2.73-1.58c.78-.45.78-1.29-.03-1.74zM2.01 1.05C1.86 1.3 1.8 1.62 1.8 1.98v20.04c0 .36.09.69.24.93l.12.12L13.17 12 2.13.93 2.01 1.05zM3.18.24L14.16 11.22l-2.61 2.61L3.18.24z"/>
          </svg>
          <div class="btn-store-text">
            <span class="label">{hero.googlePlay.label}</span>
            <span class="platform">{hero.googlePlay.platform}</span>
          </div>
        </a>
      </div>

      <p class="social-proof">
        {[0,1,2,3,4].map(() => (
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="var(--gold)" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
        <span>{hero.socialProof}</span>
      </p>
    </div>

    <div class="phone-wrap">
      <div class="phone-glow"></div>
      <div class="phone">
        <div class="phone-inner">
          <img
            class="phone-screenshot"
            src="/demo.jpeg"
            alt="Captura de pantalla de The Way"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--fill-1);
    border-bottom: 1px solid var(--stroke-1);
    padding: 80px 0 100px;
    overflow: hidden;
  }
  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--fill-2);
    border: 1px solid var(--stroke-2);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 6px 14px;
    border-radius: 100px;
    width: fit-content;
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-dark);
  }
  h1 em {
    font-style: italic;
    color: var(--gold);
  }
  .subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 480px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-store {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1a1612;
    color: #fdfcfb;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 12px;
    transition: transform 0.15s ease, background 0.2s ease;
  }
  .btn-store:hover {
    background: #2e2820;
    transform: translateY(-2px);
  }
  .btn-store-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .btn-store-text .label {
    font-size: 0.65rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }
  .btn-store-text .platform {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .social-proof {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: var(--text);
    opacity: 0.8;
  }
  .social-proof span { margin-left: 4px; }

  /* Phone */
  .phone-wrap {
    display: flex;
    justify-content: center;
    position: relative;
  }
  .phone-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(178,132,54,0.15) 0%, transparent 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .phone {
    width: 270px;
    height: 540px;
    background: #1a1612;
    border-radius: 44px;
    padding: 10px;
    box-shadow: 0 50px 100px rgba(0,0,0,0.2), 0 0 0 1px rgba(0,0,0,0.12), inset 0 0 0 1px rgba(255,255,255,0.05);
    position: relative;
  }
  .phone::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 6px;
    background: #2a2520;
    border-radius: 100px;
    z-index: 1;
  }
  .phone-inner {
    background: #0b0a09;
    border-radius: 36px;
    height: 100%;
    overflow: hidden;
    position: relative;
  }
  .phone-screenshot {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    background: #0b0a09;
  }

  @media (max-width: 880px) {
    .container { grid-template-columns: 1fr; text-align: center; gap: 48px; }
    .content { align-items: center; }
    .subtitle { max-width: 520px; }
    .social-proof { justify-content: center; }
    .phone-wrap { order: -1; }
    .phone { width: 240px; height: 480px; }
  }
</style>
