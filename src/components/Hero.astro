---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { hero } = t;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grain"></div>
    <div class="hero-glow-1"></div>
    <div class="hero-glow-2"></div>
  </div>

  <div class="container">
    <div class="content">
      <div class="badge reveal">
        <span class="badge-dot"></span>
        {hero.badge}
      </div>

      <h1 class="reveal">
        {hero.h1[0]}<br />
        <em>{hero.h1[1]}</em>
      </h1>

      <p class="subtitle reveal">{hero.subtitle}</p>

      <div class="store-badges reveal">
        <span class="btn-store btn-store--disabled" aria-disabled="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="btn-text">
            <span class="label">{hero.appStore.label}</span>
            <span class="platform">{hero.appStore.platform}</span>
          </div>
        </span>

        <a href="https://play.google.com/store/apps/details?id=com.theway" class="btn-store" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 511.999 511.999" aria-hidden="true">
            <path d="M382.369,175.623C322.891,142.356,227.427,88.937,79.355,6.028C69.372-0.565,57.886-1.429,47.962,1.93l254.05,254.05L382.369,175.623z" fill="#32BBFF"/>
            <path d="M47.962,1.93c-1.86,0.63-3.67,1.39-5.401,2.308C31.602,10.166,23.549,21.573,23.549,36v439.96c0,14.427,8.052,25.834,19.012,31.761c1.728,0.917,3.537,1.68,5.395,2.314L302.012,255.98L47.962,1.93z" fill="#32BBFF"/>
            <path d="M302.012,255.98L47.956,510.035c9.927,3.384,21.413,2.586,31.399-4.103c143.598-80.41,237.986-133.196,298.152-166.746c1.675-0.941,3.316-1.861,4.938-2.772L302.012,255.98z" fill="#32BBFF"/>
            <path d="M79.355,6.028C67.5-1.8,53.52-1.577,42.561,4.239l255.595,255.596l84.212-84.212C322.891,142.356,227.427,88.937,79.355,6.028z" fill="#29CC5E"/>
            <path d="M298.158,252.126L42.561,507.721c10.96,5.815,24.939,6.151,36.794-1.789c143.598-80.41,237.986-133.196,298.152-166.746c1.675-0.941,3.316-1.861,4.938-2.772L298.158,252.126z" fill="#D93F21"/>
            <path d="M488.45,255.98c0-12.19-6.151-24.492-18.342-31.314c0,0-22.799-12.721-92.682-51.809l-83.123,83.123l83.204,83.205c69.116-38.807,92.6-51.892,92.6-51.892C482.299,280.472,488.45,268.17,488.45,255.98z" fill="#FFD500"/>
          </svg>
          <div class="btn-text">
            <span class="label">{hero.googlePlay.label}</span>
            <span class="platform">{hero.googlePlay.platform}</span>
          </div>
        </a>
      </div>

    </div>

    <div class="phone-wrap reveal-fade">
      <div class="phone-glow"></div>
      <div class="phone">
        <div class="phone-notch" aria-hidden="true"></div>
        <div class="phone-inner">
          <img
            class="phone-screenshot"
            src="/demo.jpeg"
            alt="Captura de pantalla de BibleShep"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <div class="phone-reflection" aria-hidden="true"></div>
    </div>
  </div>
</section>


<style>
  .hero {
    background: var(--fill-1);
    border-bottom: 1px solid var(--stroke-1);
    padding: 88px 0 108px;
    overflow: hidden;
    position: relative;
  }

  /* Background atmosphere */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  .hero-glow-1 {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(178,132,54,0.08) 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }

  .hero-glow-2 {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(178,132,54,0.05) 0%, transparent 70%);
    bottom: -50px;
    left: 10%;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
    position: relative;
    z-index: 1;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--fill-2);
    border: 1px solid var(--stroke-2);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 6px 14px;
    border-radius: 100px;
    width: fit-content;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-muted);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px var(--gold-muted); }
    50%       { box-shadow: 0 0 0 6px transparent; }
  }

  /* Heading */
  h1 {
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-dark);
  }

  h1 em {
    font-style: italic;
    color: var(--gold);
    position: relative;
  }

  .subtitle {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
    max-width: 480px;
  }

  /* Store badges */
  .store-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-store {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1a1612;
    color: #fdfcfb;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 12px;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .btn-store:hover {
    background: #2e2820;
    transform: translateY(-2px);
  }

  .btn-store .btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .btn-store .label {
    font-size: 0.6rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .btn-store .platform {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .btn-store--disabled {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }


  /* Phone */
  .phone-wrap {
    display: flex;
    justify-content: center;
    position: relative;
    animation-delay: 0.3s !important;
  }

  .phone-glow {
    position: absolute;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, var(--gold-glow) 0%, transparent 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .phone {
    width: 272px;
    height: 556px;
    background: #1a1612;
    border-radius: 46px;
    padding: 10px;
    box-shadow:
      0 60px 120px rgba(0,0,0,0.22),
      0 0 0 1px rgba(0,0,0,0.14),
      inset 0 0 0 1px rgba(255,255,255,0.06);
    position: relative;
  }

  .phone-notch {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 76px;
    height: 6px;
    background: #2a2520;
    border-radius: 100px;
    z-index: 1;
  }

  .phone-inner {
    background: #0b0a09;
    border-radius: 38px;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .phone-screenshot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #0b0a09;
  }

  /* Reflejo sutil */
  .phone-reflection {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 80px;
    background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, transparent 100%);
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 48px;
    }
    .content { align-items: center; }
    .subtitle { max-width: 520px; }
    .store-badges { justify-content: center; }
    .phone-wrap { order: -1; }
    .phone { width: 240px; height: 490px; }
  }
</style>
