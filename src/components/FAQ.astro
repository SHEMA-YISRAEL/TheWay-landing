---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { faq } = t;
---

<section class="faq" id="faq">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow reveal">{faq.eyebrow}</span>
      <h2 class="reveal">{faq.h2[0]}<br /><em>{faq.h2[1]}</em></h2>
    </div>

    <div class="faq-list">
      {faq.items.map((item, i) => (
        <details class="faq-item reveal" style={`--delay: ${i * 0.06}s`}>
          <summary class="faq-question">
            <span>{item.q}</span>
            <div class="faq-icon" aria-hidden="true">
              <svg class="icon-plus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <svg class="icon-minus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </div>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--fill-1);
    padding: 96px 0;
    border-top: 1px solid var(--stroke-1);
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--text-dark);
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--stroke-1);
    opacity: 0;
    animation: fadeInUp 0.55s var(--ease-out) forwards;
    animation-delay: var(--delay, 0s);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--stroke-1);
  }

  /* Summary / pregunta */
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-dark);
    letter-spacing: -0.01em;
    line-height: 1.4;
    user-select: none;
    transition: color 0.2s ease;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question:hover {
    color: var(--gold);
  }

  .faq-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--stroke-1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .faq-question:hover .faq-icon {
    background: var(--fill-2);
    border-color: var(--stroke-2);
    color: var(--gold);
  }

  /* Mostrar/ocultar + y − */
  .icon-minus { display: none; }

  details[open] .icon-plus  { display: none; }
  details[open] .icon-minus { display: block; }

  details[open] .faq-icon {
    background: var(--gold-muted);
    border-color: var(--stroke-2);
    color: var(--gold);
  }

  details[open] .faq-question {
    color: var(--gold);
  }

  /* Respuesta */
  .faq-answer {
    padding: 0 0 22px;
    max-width: 640px;
  }

  .faq-answer p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text);
  }
</style>
