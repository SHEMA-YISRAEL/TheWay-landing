---
import type { Translations } from '../i18n/translations';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const { download } = t;
---
<section class="download" id="download">
  <div class="container">
    <div class="content">
      <span class="eyebrow">{download.eyebrow}</span>
      <h2>{download.h2[0]}<br /><em>{download.h2[1]}</em></h2>
      <p>{download.subtitle}</p>

      <div class="actions">
        <a href="#" class="btn-store">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="btn-text">
            <span class="label">{download.appStore.label}</span>
            <span class="platform">{download.appStore.platform}</span>
          </div>
        </a>

        <a href="#" class="btn-store">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.18 23.76c.3.17.64.24.99.21l12.6-12.6-2.61-2.61L3.18 23.76zM20.46 10.7l-2.7-1.56-2.94 2.94 2.94 2.94 2.73-1.58c.78-.45.78-1.29-.03-1.74zM2.01 1.05C1.86 1.3 1.8 1.62 1.8 1.98v20.04c0 .36.09.69.24.93l.12.12L13.17 12 2.13.93 2.01 1.05zM3.18.24L14.16 11.22l-2.61 2.61L3.18.24z"/>
          </svg>
          <div class="btn-text">
            <span class="label">{download.googlePlay.label}</span>
            <span class="platform">{download.googlePlay.platform}</span>
          </div>
        </a>
      </div>

      <p class="note">{download.note}</p>
    </div>

    <div class="decoration" aria-hidden="true">
      <div class="cross-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="140" height="140" viewBox="0 0 100 100" fill="none">
          <line x1="50" y1="10" x2="50" y2="90" stroke="#b28436" stroke-width="2" stroke-opacity="0.3"/>
          <line x1="15" y1="35" x2="85" y2="35" stroke="#b28436" stroke-width="2" stroke-opacity="0.3"/>
          <circle cx="50" cy="50" r="46" stroke="#b28436" stroke-width="1" stroke-opacity="0.1" stroke-dasharray="4 4"/>
          <circle cx="50" cy="50" r="30" stroke="#b28436" stroke-width="1" stroke-opacity="0.08"/>
        </svg>
      </div>
      <div class="verse-card">
        <p>{download.verseCard.quote}</p>
        <span>— {download.verseCard.ref}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    background: var(--fill-1);
    border-top: 1px solid var(--stroke-1);
    padding: 96px 0;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-dark);
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .content > p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 440px;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-store {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1a1612;
    color: #fdfcfb;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 12px;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .btn-store:hover {
    background: #2e2820;
    transform: translateY(-2px);
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .btn-text .label {
    font-size: 0.65rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .btn-text .platform {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note {
    font-size: 0.8rem;
    color: var(--text);
    opacity: 0.6;
  }

  .decoration {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    position: relative;
  }

  .cross-wrap {
    opacity: 0.8;
  }

  .verse-card {
    background: white;
    border: 1px solid var(--stroke-2);
    border-radius: 16px;
    padding: 24px 28px;
    text-align: center;
    max-width: 320px;
  }

  .verse-card p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--text-dark);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .verse-card span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .content {
      align-items: center;
    }
    .content > p {
      max-width: 100%;
    }
    .decoration {
      display: none;
    }
  }
</style>
