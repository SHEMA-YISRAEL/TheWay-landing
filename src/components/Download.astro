        </svg>
      </div>
      <div class="verse-card">
        <p>{download.verseCard.quote}</p>
        <span>— {download.verseCard.ref}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    background: var(--fill-1);
    border-top: 1px solid var(--stroke-1);
    padding: 96px 0;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-dark);
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .content > p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 440px;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-store {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1a1612;
    color: #fdfcfb;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 12px;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .btn-store:hover {
    background: #2e2820;
    transform: translateY(-2px);
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .btn-text .label {
    font-size: 0.65rem;
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  .btn-text .platform {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note {
    font-size: 0.8rem;
    color: var(--text);
    opacity: 0.6;
  }

  .decoration {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    position: relative;
  }

  .cross-wrap {
    opacity: 0.8;
  }

  .verse-card {
    background: white;
    border: 1px solid var(--stroke-2);
    border-radius: 16px;
    padding: 24px 28px;
    text-align: center;
    max-width: 320px;
  }

  .verse-card p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--text-dark);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .verse-card span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .content {
      align-items: center;
    }
    .content > p {
      max-width: 100%;
    }
    .decoration {
      display: none;
    }
  }
</style>
