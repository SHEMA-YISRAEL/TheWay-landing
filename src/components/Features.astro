---
import type { Translations } from '../i18n/translations';
interface Props { t: Translations }
const { t } = Astro.props;
const { features } = t;
---

<section class="features" id="features">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow reveal">{features.eyebrow}</span>
      <h2 class="reveal">{features.h2[0]}<br /><em>{features.h2[1]}</em></h2>
      <p class="reveal">{features.subtitle}</p>
    </div>

    <div class="grid">
      {features.items.map((f, i) => (
        <div class="card" style={`--delay: ${i * 0.08}s`}>
          <div class="card-inner">
            <div class="icon-wrap" style={`background: ${f.bg};`}>
              {f.icon === 'compass' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
              )}
              {f.icon === 'sun' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
              )}
              {f.icon === 'globe' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              )}
              {f.icon === 'bookmark' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={f.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                </svg>
              )}
            </div>
            <h3>{f.title}</h3>
            <p>{f.description}</p>
          </div>
          <div class="card-glow" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    background: #ffffff;
    padding: 104px 0;
    border-bottom: 1px solid var(--stroke-1);
    overflow: hidden;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--text-dark);
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .section-header p {
    font-size: 1rem;
    color: var(--text);
    max-width: 460px;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .card {
    position: relative;
    border-radius: 22px;
    background: var(--fill-1);
    border: 1px solid var(--stroke-1);
    overflow: hidden;
    cursor: default;
    opacity: 0;
    animation: fadeInUp 0.6s var(--ease-out) forwards;
    animation-delay: var(--delay, 0s);
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(97,93,85,0.12), 0 0 0 1px var(--stroke-2);
    border-color: var(--stroke-2);
  }

  .card:hover .card-glow {
    opacity: 1;
  }

  .card:hover .icon-wrap {
    transform: scale(1.08);
  }

  .card-inner {
    padding: 28px 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    z-index: 1;
  }

  /* Glow dorado sutil al hacer hover */
  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top left, var(--gold-muted) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-out);
  }

  h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-dark);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .card p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text);
  }

  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
